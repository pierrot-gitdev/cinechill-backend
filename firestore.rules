rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // -----------------------------------------------------------------
    // Compte — galerie, watchlist, préférences, cooldowns de swipe.
    //
    // gallery/watchlist/swipeSkips ne sont jamais écrits par le client :
    // setMediaStatus, recordSwipes et resetSwipeSkips passent par l'Admin
    // SDK côté Cloud Functions, qui ignore ces règles. Seul le read est
    // ouvert au propriétaire, pour les listeners temps réel.
    //
    // preferences reste la seule écriture directe du client — c'est
    // l'état existant (LibraryStore.writePreferences), pas une extension.
    // -----------------------------------------------------------------
    match /users/{uid} {
      match /gallery/{entryId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /watchlist/{entryId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      // Le client n'écrit que quatre documents de préférences : ses
      // plateformes (home), son profil déclaré (profile), son onboarding et
      // ses notifications. Les autres (swipeProfile, badgeState, deckPool)
      // sont tenus par le serveur, qui s'en sert pour le deck et les
      // badges : les laisser ouverts permettait de les falsifier.
      //
      // `notifications` ne porte qu'un booléen, `social`, que le serveur lit
      // avant chaque notification sociale. Rien d'autre n'y entre : le
      // document est lu par `notify`, et un champ libre serait un champ que
      // le serveur finirait par croire.
      match /preferences/{document} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && (document in ['home', 'profile', 'onboarding']
            || (document == 'notifications'
              && request.resource.data.keys().hasOnly(['social'])
              && request.resource.data.social is bool));
      }
      match /swipeSkips/{skipId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // -----------------------------------------------------------------
      // Social — le graphe de suivi.
      //
      // « following » et « followers » sont deux vues du même lien, sur
      // deux comptes différents : aucune règle scopée « if own uid » ne
      // peut les écrire ensemble de façon cohérente. followUser /
      // unfollowUser (Cloud Functions, Admin SDK) les tiennent en
      // transaction, compteurs de publicProfiles inclus.
      //
      // Lecture ouverte à tout compte connecté : les listes abonnés /
      // abonnements d'un profil sont publiques, comme le reste du profil.
      // -----------------------------------------------------------------
      match /following/{targetUid} {
        allow read: if isSignedIn();
        allow write: if false;
      }
      match /followers/{sourceUid} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      // -----------------------------------------------------------------
      // Recommandations reçues — le contenu du centre de notifications.
      //
      // Entièrement fermées en écriture côté client : sendSuggestion
      // vérifie côté serveur que l'expéditeur suit le destinataire, que
      // le film est dans sa galerie, et que le destinataire ne l'a pas
      // déjà vu — trois vérifications qu'aucune règle déclarative ne
      // peut faire de façon fiable. respondToSuggestion écrit ensuite,
      // toujours côté serveur, le statut ici et l'entrée de watchlist.
      // -----------------------------------------------------------------
      match /suggestions/{suggestionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Les comptes écartés des suggestions. Écrits par
      // dismissFollowSuggestion, lus par getFollowSuggestions, jamais par
      // le client : l'app n'en a pas besoin en direct, et rien ne justifie
      // d'exposer à qui que ce soit la liste de ceux qu'on a écartés.
      match /dismissedFollowSuggestions/{targetUid} {
        allow read, write: if false;
      }

      // -----------------------------------------------------------------
      // Blocage — écrit par blockUser / unblockUser seulement.
      //
      // Le propriétaire relit sa liste ; il ne l'écrit pas en direct, parce
      // que bloquer défait aussi les abonnements et les recommandations des
      // deux côtés, ce qu'aucune règle ne sait faire. `blockedBy` est
      // l'index inverse : il dirait à quelqu'un qui l'a bloqué, il reste
      // donc fermé à tous, propriétaire compris.
      // -----------------------------------------------------------------
      match /blocks/{targetUid} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /blockedBy/{sourceUid} {
        allow read, write: if false;
      }

      // Les appareils (jetons FCM, langue, fuseau) : tenus par
      // registerDevice / unregisterDevice, lus par le seul serveur. Un jeton
      // lisible permettrait d'envoyer des notifications à quelqu'un d'autre.
      match /devices/{deviceId} {
        allow read, write: if false;
      }

      // Les compteurs du serveur (recommandations, signalements,
      // notifications du jour) : fermés, sans quoi on pourrait les remettre
      // à zéro.
      match /limits/{document} {
        allow read, write: if false;
      }
    }

    // -----------------------------------------------------------------
    // Signalements — écrits par reportUser, lus par la seule console.
    // Le registre des jetons d'appareil (à quel compte appartient un
    // jeton) et le journal des notifications des émulateurs suivent la
    // même règle : rien pour le client.
    // -----------------------------------------------------------------
    match /reports/{reportId} {
      allow read, write: if false;
    }
    match /deviceTokens/{deviceId} {
      allow read, write: if false;
    }
    match /notificationLog/{entryId} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------
    // Profils publics — ce qu'un abonné (ou la recherche) peut voir.
    //
    // Lecture ouverte à tout compte connecté. En écriture, le
    // propriétaire ne peut toucher que son identité déclarative
    // (displayName, avatarURL, badge affiché) — jamais les compteurs.
    // followerCount / followingCount sont maintenus en transaction par
    // followUser/unfollowUser, galleryCount par evaluateBadges à chaque
    // ouverture de l'app ; les exclure ici est ce qui les rend dignes de
    // confiance à l'affichage, sans document séparé à synchroniser.
    //
    // La création est fermée, et c'est elle qui garantit l'unicité des pseudos.
    // Aucune règle déclarative ne peut vérifier qu'un pseudo est libre : il
    // faut lire `usernames/{handle}` et y écrire dans le même souffle, ce que
    // seule une transaction sait faire. claimHandle la tient, côté serveur, via
    // l'Admin SDK qui ignore ces règles. Laisser le client créer ce document
    // ouvrirait un second chemin vers la même donnée, celui-là sans registre :
    // deux comptes pourraient porter le même pseudo, ou reprendre celui d'un
    // autre. L'app ne l'empruntait pas — SocialStore ne fait que compléter un
    // document déjà créé par claimHandle.
    // -----------------------------------------------------------------
    match /publicProfiles/{uid} {
      allow read: if isSignedIn();
      allow create: if false;
      // displayNameNormalized est écrit par le client en même temps que
      // displayName (voir SocialStore.syncDisplayName) : c'est ce qui
      // permet à la recherche de trouver un profil par prénom/nom, pas
      // seulement par pseudo.
      // searchPrefixes n'est pas dans la liste, et ne doit pas y entrer :
      // un tableau libre permettrait à n'importe qui d'y glisser des mots
      // pour sortir dans les recherches des autres. Seuls claimHandle et
      // setPublicName l'écrivent.
      // avatarURL et badgeSignature ne sont plus ouverts : l'app ne les
      // écrit pas, et une URL d'avatar libre faisait télécharger une image
      // de n'importe quel serveur à quiconque regardait le profil. Le nom
      // est borné.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'displayNameNormalized'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.displayNameNormalized is string
        && request.resource.data.displayNameNormalized.size() <= 60;
      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // Réservation des pseudos — garde-fou d'unicité, jamais lu par le
    // client (la recherche interroge publicProfiles.handleNormalized,
    // pas cette collection). Écrite uniquement par claimHandle, dans
    // une transaction qui vérifie l'absence du document avant de le
    // créer : c'est ça, et seulement ça, qui garantit l'unicité.
    // -----------------------------------------------------------------
    match /usernames/{handle} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------
    // Les sagas — cache global, partagé par tous les comptes et écrit
    // uniquement par le serveur (getSwipeFeed, getCollection). Le client
    // ne le lit jamais en direct : il passe par getCollection, qui sait
    // retomber sur TMDB quand le cache ne connaît pas encore la saga.
    // -----------------------------------------------------------------
    match /collections/{collectionId} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------
    // Les suggestions de comptes à suivre — tenues par getFollowSuggestions.
    //
    // tasteIndex porte la liste des films vus de chaque compte : c'est la
    // galerie, que les règles ferment déjà à autrui, sous une autre forme.
    // followSuggestionCache est un classement calculé pour un compte. Ni
    // l'un ni l'autre n'est lu par le client : le serveur n'en renvoie que
    // des agrégats (nombre de films en commun), jamais les identifiants.
    // Les règles refusent déjà par défaut ; ces blocs le disent.
    // -----------------------------------------------------------------
    match /tasteIndex/{uid} {
      allow read, write: if false;
    }
    match /followSuggestionCache/{uid} {
      allow read, write: if false;
    }
  }
}
